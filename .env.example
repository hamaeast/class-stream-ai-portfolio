# Copy to .env.local and fill in. Placeholders only — never commit real values.

# Base44 app connection (full app only; not used by demo/)
VITE_BASE44_APP_ID=your_base44_app_id
VITE_BASE44_APP_BASE_URL=https://your-app.base44.app

# School branding
VITE_SCHOOL_SHORT_NAME=Example JH
VITE_COURSE_NAME=Computer Science
VITE_DISTRICT_SHORT_NAME=Example District
VITE_SCHOOL_YEAR_LABEL=2026-2027
VITE_SCHOOL_CALENDAR_IMAGE_URL=
VITE_PACING_GUIDE_URL=

# Google Drive lesson-plan documents: JSON object of lesson title -> Drive file ID
VITE_LESSON_PLAN_FILE_IDS={"What Is Computer Science?": "your_drive_file_id"}

# Lesson record IDs that should not get an auto-created graded assignment (comma-separated)
VITE_NO_ASSIGNMENT_LESSON_IDS=

# Base44 backend function secret (set in the Base44 dashboard, not in this file)
# PACING_FILE_ID=your_pacing_workbook_drive_file_id
