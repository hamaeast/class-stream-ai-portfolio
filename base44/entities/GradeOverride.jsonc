{
  "name": "GradeOverride",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "The student this override applies to."
    },
    "column_key": {
      "type": "string",
      "description": "Gradebook column identifier: 'quiz|<lessonId>', 'asg|<assignmentId>', 'notes|<lessonId>', or 'practice|<lessonId>'."
    },
    "value": {
      "type": "string",
      "description": "Override value: a numeric percent (e.g. '85'), a letter grade (e.g. 'B'), or 'EX' for exempt."
    },
    "note": {
      "type": "string",
      "default": "",
      "description": "Optional teacher note explaining the override."
    }
  },
  "required": [
    "student_id",
    "column_key",
    "value"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}