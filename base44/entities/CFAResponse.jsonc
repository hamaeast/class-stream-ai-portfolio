{
  "name": "CFAResponse",
  "type": "object",
  "properties": {
    "cfa_id": {
      "type": "string",
      "description": "The CFA this response belongs to."
    },
    "answers_text": {
      "type": "string",
      "description": "JSON { selections: { questionIndex: choiceIndex } }"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the graded attempt was submitted."
    },
    "score": {
      "type": "number",
      "default": 0,
      "description": "Number of correct answers (auto-graded)."
    },
    "total": {
      "type": "number",
      "default": 0,
      "description": "Total questions in the CFA."
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "graded"
      ],
      "default": "in_progress"
    },
    "student_id": {
      "type": "string",
      "description": "Security: the student who owns this record. Set by the server function that writes it (service-role writes stamp created_by_id to the service, so ownership is anchored here). Legacy rows written by the student match on created_by_id instead."
    }
  },
  "required": [
    "cfa_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}