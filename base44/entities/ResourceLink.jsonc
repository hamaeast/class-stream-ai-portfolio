{
  "name": "ResourceLink",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Display title of the link."
    },
    "url": {
      "type": "string",
      "description": "Destination URL."
    },
    "description": {
      "type": "string",
      "default": "",
      "description": "Short description shown under the link in the student Links tab."
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}