{
  "name": "CheckIn",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "The lesson the student opened"
    },
    "part": {
      "type": "string",
      "description": "Which part of the lesson was opened",
      "enum": [
        "lesson",
        "notes",
        "practice",
        "quiz"
      ],
      "default": "lesson"
    }
  },
  "required": [
    "lesson_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}