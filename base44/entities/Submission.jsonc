{
  "name": "Submission",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string"
    },
    "submission_text": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "graded"
      ],
      "default": "submitted"
    },
    "grade": {
      "type": "string"
    },
    "feedback": {
      "type": "string"
    },
    "student_id": {
      "type": "string",
      "description": "Security: the student who owns this record. Set by the server function that writes it (service-role writes stamp created_by_id to the service, so ownership is anchored here). Legacy rows written by the student match on created_by_id instead."
    }
  },
  "required": [
    "assignment_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}